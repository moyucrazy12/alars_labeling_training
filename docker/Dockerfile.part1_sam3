FROM nvidia/cuda:12.8.1-cudnn-devel-ubuntu22.04

ARG USER_UID=1000
ARG USER_GID=1000
ARG USER_NAME=developer

ENV DEBIAN_FRONTEND=noninteractive
ENV PYTHONUNBUFFERED=1
ENV HOME=/home/${USER_NAME}
ENV HF_HOME=/home/${USER_NAME}/.cache/huggingface
ENV PATH=/home/${USER_NAME}/.local/bin:${PATH}

RUN apt-get update && apt-get install -y \
    software-properties-common \
    ca-certificates \
    curl \
    wget \
    git \
    sudo \
    build-essential \
    pkg-config \
    libgl1 \
    libglib2.0-0 \
    && rm -rf /var/lib/apt/lists/*

RUN mkdir -p /etc/sudoers.d && \
    if ! getent group ${USER_GID} > /dev/null; then \
        groupadd --gid ${USER_GID} ${USER_NAME}; \
    fi && \
    if ! id -u ${USER_NAME} > /dev/null 2>&1; then \
        useradd --uid ${USER_UID} \
                --gid ${USER_GID} \
                --create-home \
                --shell /bin/bash \
                ${USER_NAME}; \
    fi && \
    echo "${USER_NAME} ALL=(ALL) NOPASSWD:ALL" > /etc/sudoers.d/${USER_NAME} && \
    chmod 0440 /etc/sudoers.d/${USER_NAME}

RUN add-apt-repository ppa:deadsnakes/ppa -y && \
    apt-get update && apt-get install -y \
    python3.12 \
    python3.12-dev \
    python3.12-venv \
    && rm -rf /var/lib/apt/lists/*

RUN curl -sS https://bootstrap.pypa.io/get-pip.py | python3.12

RUN python3.12 -m pip install --no-cache-dir --upgrade pip

RUN python3.12 -m pip install --no-cache-dir \
    torch==2.10.0 \
    torchvision \
    --index-url https://download.pytorch.org/whl/cu128

RUN git clone https://github.com/facebookresearch/sam3.git /opt/sam3 && \
    python3.12 -m pip install --no-cache-dir -e "/opt/sam3[train,dev]"

RUN mkdir -p /opt/sam3/assets && \
    wget -O /opt/sam3/assets/bpe_simple_vocab_16e6.txt.gz \
    https://github.com/openai/CLIP/raw/refs/heads/main/clip/bpe_simple_vocab_16e6.txt.gz

RUN python3.12 -m pip install --no-cache-dir \
    ultralytics \
    huggingface_hub \
    opencv-python \
    pyyaml \
    numpy \
    matplotlib \
    einops

RUN mkdir -p /workspace /home/${USER_NAME}/.cache/huggingface && \
    chown -R ${USER_UID}:${USER_GID} /workspace /home/${USER_NAME}

USER ${USER_NAME}

WORKDIR /workspace/alars_labeling_training