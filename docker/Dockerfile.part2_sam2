FROM nvidia/cuda:12.4.1-cudnn-devel-ubuntu22.04

ARG USER_UID=1000
ARG USER_GID=1000
ARG USER_NAME=developer

ENV DEBIAN_FRONTEND=noninteractive
ENV PYTHONUNBUFFERED=1
ENV HOME=/home/${USER_NAME}
ENV PATH=/home/${USER_NAME}/.local/bin:${PATH}

RUN apt-get update && apt-get install -y \
    python3 \
    python3-pip \
    python3-dev \
    git \
    wget \
    curl \
    sudo \
    libgl1 \
    libglib2.0-0 \
    libxext6 \
    libsm6 \
    libxrender1 \
    libgtk2.0-dev \
    fontconfig \
    fonts-dejavu-core \
    fonts-dejavu-extra \
    && rm -rf /var/lib/apt/lists/*

RUN mkdir -p /etc/sudoers.d && \
    if ! getent group ${USER_GID} > /dev/null; then \
        groupadd --gid ${USER_GID} ${USER_NAME}; \
    fi && \
    if ! id -u ${USER_NAME} > /dev/null 2>&1; then \
        useradd --uid ${USER_UID} \
                --gid ${USER_GID} \
                --create-home \
                --shell /bin/bash \
                ${USER_NAME}; \
    fi && \
    echo "${USER_NAME} ALL=(ALL) NOPASSWD:ALL" > /etc/sudoers.d/${USER_NAME} && \
    chmod 0440 /etc/sudoers.d/${USER_NAME}

RUN python3 -m pip install --no-cache-dir --upgrade pip

RUN python3 -m pip install --no-cache-dir \
    torch \
    torchvision \
    --index-url https://download.pytorch.org/whl/cu124

RUN git clone https://github.com/facebookresearch/sam2.git /opt/sam2 && \
    python3 -m pip install --no-cache-dir -e /opt/sam2

RUN python3 -m pip install --no-cache-dir \
    opencv-python \
    pyyaml \
    numpy \
    matplotlib

RUN python3 - <<'PY'
from pathlib import Path
import cv2

cv2_dir = Path(cv2.__file__).resolve().parent
qt_fonts_dir = cv2_dir / "qt" / "fonts"
system_fonts_dir = Path("/usr/share/fonts/truetype/dejavu")

qt_fonts_dir.mkdir(parents=True, exist_ok=True)

for font_path in system_fonts_dir.glob("*.ttf"):
    target = qt_fonts_dir / font_path.name
    if not target.exists():
        target.symlink_to(font_path)

print(f"[INFO] OpenCV Qt font dir: {qt_fonts_dir}")
PY

COPY docker/entrypoint_part2.sh /usr/local/bin/entrypoint_part2.sh
RUN chmod +x /usr/local/bin/entrypoint_part2.sh

RUN mkdir -p /workspace && \
    chown -R ${USER_UID}:${USER_GID} /workspace /home/${USER_NAME}

USER ${USER_NAME}

WORKDIR /workspace/alars_labeling_training

ENTRYPOINT ["/usr/local/bin/entrypoint_part2.sh"]