FROM nvidia/cuda:12.4.1-cudnn-devel-ubuntu22.04

ARG USER_UID=1000
ARG USER_GID=1000
ARG USER_NAME=developer

ENV DEBIAN_FRONTEND=noninteractive
ENV PYTHONUNBUFFERED=1
ENV HOME=/home/${USER_NAME}
ENV PATH=/home/${USER_NAME}/.local/bin:${PATH}
ENV LANG=en_US.UTF-8
ENV LC_ALL=en_US.UTF-8

SHELL ["/bin/bash", "-c"]

RUN apt-get update && apt-get install -y \
    software-properties-common \
    ca-certificates \
    curl \
    wget \
    git \
    gnupg \
    lsb-release \
    locales \
    sudo \
    build-essential \
    python3 \
    python3-pip \
    python3-dev \
    libgl1 \
    libglib2.0-0 \
    && locale-gen en_US en_US.UTF-8 \
    && rm -rf /var/lib/apt/lists/*

# ROS 2 Humble repository, needed for rosbag2_py and cv_bridge.
RUN curl -sSL https://raw.githubusercontent.com/ros/rosdistro/master/ros.key \
    -o /usr/share/keyrings/ros-archive-keyring.gpg && \
    echo "deb [arch=$(dpkg --print-architecture) signed-by=/usr/share/keyrings/ros-archive-keyring.gpg] http://packages.ros.org/ros2/ubuntu $(. /etc/os-release && echo ${UBUNTU_CODENAME}) main" \
    > /etc/apt/sources.list.d/ros2.list

RUN apt-get update && apt-get install -y \
    ros-humble-rosbag2-py \
    ros-humble-rosbag2-storage-default-plugins \
    ros-humble-rosbag2-storage-mcap \
    ros-humble-cv-bridge \
    ros-humble-sensor-msgs \
    ros-humble-rosidl-runtime-py \
    ros-humble-rclpy \
    && rm -rf /var/lib/apt/lists/*

RUN mkdir -p /etc/sudoers.d && \
    if ! getent group ${USER_GID} > /dev/null; then \
        groupadd --gid ${USER_GID} ${USER_NAME}; \
    fi && \
    if ! id -u ${USER_NAME} > /dev/null 2>&1; then \
        useradd --uid ${USER_UID} \
                --gid ${USER_GID} \
                --create-home \
                --shell /bin/bash \
                ${USER_NAME}; \
    fi && \
    echo "${USER_NAME} ALL=(ALL) NOPASSWD:ALL" > /etc/sudoers.d/${USER_NAME} && \
    chmod 0440 /etc/sudoers.d/${USER_NAME}

RUN python3 -m pip install --no-cache-dir --upgrade pip

RUN python3 -m pip install --no-cache-dir \
    torch \
    torchvision \
    --index-url https://download.pytorch.org/whl/cu124

RUN python3 -m pip install --no-cache-dir \
    "numpy<2" \
    pandas \
    pyyaml \
    tqdm \
    pillow \
    scikit-learn \
    hdbscan

RUN mkdir -p /workspace /home/${USER_NAME}/.cache/torch && \
    chown -R ${USER_UID}:${USER_GID} /workspace /home/${USER_NAME}

USER ${USER_NAME}

WORKDIR /workspace/alars_labeling_training